# Twitch Developer Credentials for IGDB API v4
# Register at https://dev.twitch.tv/console
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# Optional: Steam Web API key, for importing your Steam library.
# Free from https://steamcommunity.com/dev/apikey - the app can also save it
# for you from File > Import from Steam.
STEAM_API_KEY=

# Application Server Settings
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=data/games.db
